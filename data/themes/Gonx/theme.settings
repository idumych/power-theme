# Gonx, after the "Gonx" BeOS concept by Cotito (cotito.free.fr, c. 2001),
# as done by the Gonx project (github.com/idumych/gonx), whose decorator and
# control look must be installed. Values from its gonx-theme tool, over
# Haiku's default colours, as Gonx was drawn.

name = Gonx
description = The Gonx BeOS concept: a yellow tab hanging off a blue-grey frame, buttons on a raised shelf, and light, nearly square controls. Needs Gonx (github.com/idumych/gonx).
decorator = Gonx
control look = Gonx
icons = haiku
desktop color = #809DBD
wallpaper = none

font plain = Noto Sans, Regular, 9
font bold = Noto Sans, Bold, 11
font menu = Noto Sans, Regular, 9

color B_PANEL_BACKGROUND_COLOR = #ECEBE6
color B_MENU_BACKGROUND_COLOR = #F7F7F5
color B_WINDOW_TAB_COLOR = #FBCC00
color B_KEYBOARD_NAVIGATION_COLOR = #4F6C97
color B_DESKTOP_COLOR = #809DBD
color B_MENU_SELECTED_BACKGROUND_COLOR = #9EB2CA
color B_MENU_ITEM_TEXT_COLOR = #000000
color B_MENU_SELECTED_ITEM_TEXT_COLOR = #000000
color B_MENU_SELECTED_BORDER_COLOR = #4F5B6B
color B_PANEL_TEXT_COLOR = #000000
color B_DOCUMENT_BACKGROUND_COLOR = #FFFFFF
color B_DOCUMENT_TEXT_COLOR = #000000
color B_CONTROL_BACKGROUND_COLOR = #DEDEDE
color B_CONTROL_TEXT_COLOR = #000000
color B_CONTROL_BORDER_COLOR = #ACACAC
color B_CONTROL_HIGHLIGHT_COLOR = #6698CB
color B_NAVIGATION_PULSE_COLOR = #000000
color B_SHINE_COLOR = #FFFFFF
color B_SHADOW_COLOR = #000000
color B_TOOLTIP_BACKGROUND_COLOR = #FFFFD8
color B_TOOLTIP_TEXT_COLOR = #000000
color B_WINDOW_TEXT_COLOR = #000000
color B_WINDOW_INACTIVE_TAB_COLOR = #EBEBEB
color B_WINDOW_INACTIVE_TEXT_COLOR = #4C4C4C
color B_WINDOW_BORDER_COLOR = #9EB2CA
color B_WINDOW_INACTIVE_BORDER_COLOR = #A6B7CC
color B_CONTROL_MARK_COLOR = #1B528C
color B_LIST_BACKGROUND_COLOR = #FFFFFF
color B_LIST_SELECTED_BACKGROUND_COLOR = #AABBD0
color B_LIST_ITEM_TEXT_COLOR = #000000
color B_LIST_SELECTED_ITEM_TEXT_COLOR = #000000
color B_SCROLL_BAR_THUMB_COLOR = #D8D8D8
color B_LINK_TEXT_COLOR = #3366BB
