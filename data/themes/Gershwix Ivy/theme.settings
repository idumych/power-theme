# "Gershwix Ivy", after Gershwix 2.5 by Mintar (2002-2007), a Platinum theme
# for Mac OS X's ShapeShifter. Colours and sizes measured from its pictures; the
# window borders and controls are drawn from scratch and none of its artwork is
# used. The control look takes its accent from the scroll bar thumb colour.

name = Gershwix Ivy
description = Mintar's Gershwix: a striped grey title bar with square close, minimize and zoom boxes, light bevelled buttons, and scroll bars, sliders and progress bars in ivy green.
decorator = Gershwix
control look = Gershwix
wallpaper = none
desktop color = #4A6B48
deskbar = top, expanded
font plain = Lucida Grande | Noto Sans, Regular, 12
font bold = Lucida Grande | Noto Sans, Bold, 12
font fixed = Monaco | Noto Sans Mono, Regular, 12
font menu = Lucida Grande | Noto Sans, Regular, 12
icons = NineIconsRedux

color B_DESKTOP_COLOR = #4A6B48
color B_PANEL_BACKGROUND_COLOR = #EBEBEB
color B_PANEL_TEXT_COLOR = #000000
color B_DOCUMENT_BACKGROUND_COLOR = #FFFFFF
color B_DOCUMENT_TEXT_COLOR = #000000
color B_CONTROL_BACKGROUND_COLOR = #FFFFFF
color B_CONTROL_TEXT_COLOR = #000000
color B_CONTROL_BORDER_COLOR = #808080
color B_CONTROL_HIGHLIGHT_COLOR = #6A9C67
color B_CONTROL_MARK_COLOR = #2F2F2F
color B_KEYBOARD_NAVIGATION_COLOR = #517F4E
color B_NAVIGATION_PULSE_COLOR = #82BE7E
color B_SHINE_COLOR = #FFFFFF
color B_SHADOW_COLOR = #000000
color B_MENU_BACKGROUND_COLOR = #EBEBEB
color B_MENU_SELECTED_BACKGROUND_COLOR = #043E00
color B_MENU_ITEM_TEXT_COLOR = #000000
color B_MENU_SELECTED_ITEM_TEXT_COLOR = #FFFFFF
color B_MENU_SELECTED_BORDER_COLOR = #043E00
color B_LIST_BACKGROUND_COLOR = #FFFFFF
color B_LIST_ITEM_TEXT_COLOR = #000000
color B_LIST_SELECTED_BACKGROUND_COLOR = #8DBF89
color B_LIST_SELECTED_ITEM_TEXT_COLOR = #000000
color B_SCROLL_BAR_THUMB_COLOR = #6A9C67
color B_STATUS_BAR_COLOR = #6A9C67
color B_TOOLTIP_BACKGROUND_COLOR = #FFFFC7
color B_TOOLTIP_TEXT_COLOR = #000000
color B_WINDOW_TAB_COLOR = #E6E6E6
color B_WINDOW_TEXT_COLOR = #000000
color B_WINDOW_INACTIVE_TAB_COLOR = #E6E6E6
color B_WINDOW_INACTIVE_TEXT_COLOR = #808080
color B_WINDOW_BORDER_COLOR = #4D4D4D
color B_WINDOW_INACTIVE_BORDER_COLOR = #8C8C8C
