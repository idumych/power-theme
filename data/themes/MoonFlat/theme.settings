# MoonFlat, converted from a Theme Manager theme by
# tools/import-uitheme.py. Colours it leaves out are Haiku's dark defaults.
# From haiku_darkstyle by unarix (github.com/unarix/haiku_darkstyle, MIT).

name = MoonFlat
description = Moonlit and flat: blue-grey dark panels with amber window tabs, over a night sky. From haiku_darkstyle by unarix.
decorator = FlatDecorator | Default
control look = FlatControlLook | haiku
icons = haiku
desktop color = #0F1316
deskbar = right top, expanded
wallpaper = wallpaper.jpg
wallpaper mode = scaled

font plain = Noto Sans Display | Noto Sans, Regular, 12
font bold = Noto Sans Display | Noto Sans, Medium | Bold, 12
font fixed = Noto Sans Mono, Regular, 12
font menu = Noto Sans Display | Noto Sans, Regular, 12

color B_PANEL_BACKGROUND_COLOR = #282E33
color B_MENU_BACKGROUND_COLOR = #282E33
color B_WINDOW_TAB_COLOR = #FFB900
color B_KEYBOARD_NAVIGATION_COLOR = #282E33
color B_DESKTOP_COLOR = #0F1316
color B_MENU_SELECTED_BACKGROUND_COLOR = #282E33
color B_MENU_ITEM_TEXT_COLOR = #A6AFB8
color B_MENU_SELECTED_ITEM_TEXT_COLOR = #C6D2DC
color B_MENU_SELECTED_BORDER_COLOR = #282E33
color B_PANEL_TEXT_COLOR = #A6AFB8
color B_DOCUMENT_BACKGROUND_COLOR = #3D4446
color B_DOCUMENT_TEXT_COLOR = #A6AFB8
color B_CONTROL_BACKGROUND_COLOR = #3D444B
color B_CONTROL_TEXT_COLOR = #A6AFB8
color B_CONTROL_BORDER_COLOR = #282E33
color B_CONTROL_HIGHLIGHT_COLOR = #282E33
color B_NAVIGATION_PULSE_COLOR = #282E33
color B_SHINE_COLOR = #282E33
color B_SHADOW_COLOR = #282E33
color B_TOOLTIP_BACKGROUND_COLOR = #32383D
color B_TOOLTIP_TEXT_COLOR = #AAAAAA
color B_WINDOW_TEXT_COLOR = #080808
color B_WINDOW_INACTIVE_TAB_COLOR = #32383D
color B_WINDOW_INACTIVE_TEXT_COLOR = #969696
color B_WINDOW_BORDER_COLOR = #282E33
color B_WINDOW_INACTIVE_BORDER_COLOR = #282E33
color B_CONTROL_MARK_COLOR = #3C4247
color B_LIST_BACKGROUND_COLOR = #18191D
color B_LIST_SELECTED_BACKGROUND_COLOR = #2D3033
color B_LIST_ITEM_TEXT_COLOR = #AAAAAA
color B_LIST_SELECTED_ITEM_TEXT_COLOR = #AAAAAA
color B_SCROLL_BAR_THUMB_COLOR = #FFBB2E
color B_LINK_TEXT_COLOR = #6A70D4
color B_LINK_HOVER_COLOR = #6698CB
color B_LINK_VISITED_COLOR = #91709B
color B_LINK_ACTIVE_COLOR = #798ECB
color B_STATUS_BAR_COLOR = #3296FF
color B_SUCCESS_COLOR = #35B135
color B_FAILURE_COLOR = #BA3535
