# "Expose", after Expose Dark and Expose Air Dark by Mark Whittaker
# (store.kde.org/p/2347990, store.kde.org/p/2357405), GNU GPL.
# Colours from the Expose Dark colour scheme and Kvantum theme
# (store.kde.org/p/2348069).

name = Expose
variant of = Expose
mode = light
description = A dark glossy title bar with glass buttons and a red close button, over soft grey controls with orange-topped tabs, after Expose Dark for KDE.
decorator = Expose
control look = Expose
wallpaper = none
desktop color = #6C8690
font plain = Noto Sans, Regular, 12
font bold = Noto Sans, Bold, 12
font fixed = Noto Sans Mono, Regular, 12
font menu = Noto Sans, Regular, 12
icons = haiku

color B_DESKTOP_COLOR = #6C8690
color B_PANEL_BACKGROUND_COLOR = #D7D7D7
color B_PANEL_TEXT_COLOR = #000000
color B_DOCUMENT_BACKGROUND_COLOR = #FFFFFF
color B_DOCUMENT_TEXT_COLOR = #000000
color B_CONTROL_BACKGROUND_COLOR = #FFFFFF
color B_CONTROL_TEXT_COLOR = #272818
color B_CONTROL_BORDER_COLOR = #707070
color B_CONTROL_HIGHLIGHT_COLOR = #F7BA63
color B_CONTROL_MARK_COLOR = #DE7921
color B_KEYBOARD_NAVIGATION_COLOR = #DE7921
color B_NAVIGATION_PULSE_COLOR = #F7BA63
color B_SHINE_COLOR = #FFFFFF
color B_SHADOW_COLOR = #000000
color B_MENU_BACKGROUND_COLOR = #FCFCFC
color B_MENU_SELECTED_BACKGROUND_COLOR = #BDBDBD
color B_MENU_ITEM_TEXT_COLOR = #000000
color B_MENU_SELECTED_ITEM_TEXT_COLOR = #000000
# Kvantum draws no border here, but ZSnake needs one to show as a band
color B_MENU_SELECTED_BORDER_COLOR = #707070
color B_LIST_BACKGROUND_COLOR = #FFFFFF
color B_LIST_ITEM_TEXT_COLOR = #000000
color B_LIST_SELECTED_BACKGROUND_COLOR = #F7BA63
color B_LIST_SELECTED_ITEM_TEXT_COLOR = #000000
color B_SCROLL_BAR_THUMB_COLOR = #E4E4E4
color B_STATUS_BAR_COLOR = #E09B38
color B_TOOLTIP_BACKGROUND_COLOR = #E1E1E1
color B_TOOLTIP_TEXT_COLOR = #000000
color B_WINDOW_TAB_COLOR = #595959
color B_WINDOW_TEXT_COLOR = #FFFFFF
color B_WINDOW_INACTIVE_TAB_COLOR = #333333
color B_WINDOW_INACTIVE_TEXT_COLOR = #FFFFFF
color B_WINDOW_BORDER_COLOR = #2A2A2A
