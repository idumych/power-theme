# "Amiga", in the style of the Amiga's Workbench 1.3 as Arthur Choung's HOTDOG
# draws it (GPL 3 or later): its colours, window gadgets and controls.

name = Amiga
description = The Amiga's Workbench 1.3, after HOTDOG: white title bars with blue stripes and gadgets, blue windows with white text, orange and blue buttons, and a blue desktop.
decorator = Amiga
control look = Amiga
wallpaper = none
desktop color = #0055AA
deskbar = top, expanded
font plain = HOTDOG Topaz | Noto Sans Mono, Regular, 16
font bold = HOTDOG Topaz | Noto Sans Mono, Bold, 16
font fixed = HOTDOG Topaz | Noto Sans Mono, Regular, 16
font menu = HOTDOG Topaz | Noto Sans Mono, Regular, 16
icons = Workbench
font smoothing = grey

color B_DESKTOP_COLOR = #0055AA
color B_PANEL_BACKGROUND_COLOR = #FFFFFF
color B_PANEL_TEXT_COLOR = #0055AA
color B_DOCUMENT_BACKGROUND_COLOR = #0055AA
color B_DOCUMENT_TEXT_COLOR = #FFFFFF
color B_CONTROL_BACKGROUND_COLOR = #0055AA
color B_CONTROL_TEXT_COLOR = #0055AA
color B_CONTROL_BORDER_COLOR = #0055AA
color B_CONTROL_HIGHLIGHT_COLOR = #FF8800
color B_CONTROL_MARK_COLOR = #000022
color B_KEYBOARD_NAVIGATION_COLOR = #FF8800
color B_NAVIGATION_PULSE_COLOR = #FF8800
color B_SHINE_COLOR = #FFFFFF
color B_SHADOW_COLOR = #000022
color B_MENU_BACKGROUND_COLOR = #FFFFFF
color B_MENU_SELECTED_BACKGROUND_COLOR = #000022
color B_MENU_ITEM_TEXT_COLOR = #0055AA
color B_MENU_SELECTED_ITEM_TEXT_COLOR = #FF8800
color B_MENU_SELECTED_BORDER_COLOR = #000022
color B_LIST_BACKGROUND_COLOR = #0055AA
color B_LIST_ITEM_TEXT_COLOR = #FFFFFF
color B_LIST_SELECTED_BACKGROUND_COLOR = #000022
color B_LIST_SELECTED_ITEM_TEXT_COLOR = #FF8800
color B_SCROLL_BAR_THUMB_COLOR = #0055AA
color B_STATUS_BAR_COLOR = #FF8800
color B_TOOLTIP_BACKGROUND_COLOR = #FFFFFF
color B_TOOLTIP_TEXT_COLOR = #0055AA
color B_WINDOW_TAB_COLOR = #FFFFFF
color B_WINDOW_TEXT_COLOR = #0055AA
color B_WINDOW_INACTIVE_TAB_COLOR = #FFFFFF
color B_WINDOW_INACTIVE_TEXT_COLOR = #0055AA
color B_WINDOW_BORDER_COLOR = #FFFFFF
color B_WINDOW_INACTIVE_BORDER_COLOR = #FFFFFF
