# "Tidy", after the mockups by anon40228759 on Haiku's forum ("UI adjustments
# that stay out of the way", 2025). Colours measured from them.

name = Tidy
variant of = Tidy
mode = light
description = The Tidy mockups from Haiku's forum: a rounded yellow tab, a thin frame, soft menu bars, pale column headers and slim scroll bars.
decorator = Tidy
control look = Tidy
wallpaper = default
desktop color = #336698
font plain = Noto Sans, Regular, 12
font bold = Noto Sans, Bold, 12
font fixed = Noto Sans Mono, Regular, 12
font menu = Noto Sans, Regular, 12

color B_DESKTOP_COLOR = #336698
icons = haiku

