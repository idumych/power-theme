# "Platinum", after Platinum Retro OS9 by Niels (store.kde.org/p/2361987, GNU GPL),
# in the style of Mac OS 9. Colours from the QPlatinum colour scheme
# (store.kde.org/p/1287747) and measured from the Mac9Kvantum theme
# (store.kde.org/p/1766812). The wallpaper comes with the global theme, and the
# icons are NineIcons Redux by aitees (store.kde.org/p/1960539, MIT).

name = Platinum
description = Mac OS 9's Platinum: a wide bevelled frame with a striped title bar, grey bevelled buttons, lavender scroll bars and pop-up arrows, on a tiled lilac desktop.
decorator = Platinum
control look = Platinum
wallpaper = wallpaper.jpg
wallpaper mode = tiled
desktop color = #62609F
deskbar = right top, expanded
font plain = Noto Sans, Regular, 12
font bold = Noto Sans, Bold, 12
font fixed = Noto Sans Mono, Regular, 12
font menu = Noto Sans, Regular, 12
icons = NineIconsRedux

color B_DESKTOP_COLOR = #62609F
color B_PANEL_BACKGROUND_COLOR = #DDDDDD
color B_PANEL_TEXT_COLOR = #000000
color B_DOCUMENT_BACKGROUND_COLOR = #FEFEFF
color B_DOCUMENT_TEXT_COLOR = #000000
color B_CONTROL_BACKGROUND_COLOR = #FEFEFF
color B_CONTROL_TEXT_COLOR = #000000
color B_CONTROL_BORDER_COLOR = #222222
color B_CONTROL_HIGHLIGHT_COLOR = #6666CC
color B_CONTROL_MARK_COLOR = #000000
color B_KEYBOARD_NAVIGATION_COLOR = #6666CC
color B_NAVIGATION_PULSE_COLOR = #9999FF
color B_SHINE_COLOR = #FFFFFF
color B_SHADOW_COLOR = #000000
color B_MENU_BACKGROUND_COLOR = #DDDDDD
color B_MENU_SELECTED_BACKGROUND_COLOR = #333399
color B_MENU_ITEM_TEXT_COLOR = #000000
color B_MENU_SELECTED_ITEM_TEXT_COLOR = #FFFFFF
color B_MENU_SELECTED_BORDER_COLOR = #000000
color B_LIST_BACKGROUND_COLOR = #FEFEFF
color B_LIST_ITEM_TEXT_COLOR = #000000
color B_LIST_SELECTED_BACKGROUND_COLOR = #CDCDFF
color B_LIST_SELECTED_ITEM_TEXT_COLOR = #000000
color B_SCROLL_BAR_THUMB_COLOR = #9999FF
color B_STATUS_BAR_COLOR = #6666CC
color B_TOOLTIP_BACKGROUND_COLOR = #EDEDEE
color B_TOOLTIP_TEXT_COLOR = #000000
color B_WINDOW_TAB_COLOR = #C7C7C7
color B_WINDOW_TEXT_COLOR = #000000
color B_WINDOW_INACTIVE_TAB_COLOR = #DDDDDD
color B_WINDOW_INACTIVE_TEXT_COLOR = #646464
color B_WINDOW_BORDER_COLOR = #C7C7C7
