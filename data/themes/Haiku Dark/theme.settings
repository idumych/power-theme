# Haiku's own look in black and yellow: the default window decorator and the
# built-in controls, with DarkFlat's colours (from haiku_darkstyle by unarix,
# MIT) and desktop colour, and Haiku's fonts and icons.

name = Haiku Dark
variant of = Haiku
mode = dark
description = Haiku's own look in black and yellow: the built-in controls with charcoal panels and yellow window tabs, the default fonts and Haiku's icons.
decorator = Default
control look = haiku
icons = haiku
wallpaper = default
deskbar = right top, expanded
desktop color = #0E0E0E

font plain = Noto Sans, Regular, 12
font bold = Noto Sans, Bold, 12
font fixed = Noto Sans Mono, Regular, 12
font menu = Noto Sans, Regular, 12

color B_PANEL_BACKGROUND_COLOR = #353535
color B_MENU_BACKGROUND_COLOR = #353535
color B_WINDOW_TAB_COLOR = #EDC746
color B_KEYBOARD_NAVIGATION_COLOR = #646464
