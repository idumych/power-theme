# The dark version of "Tidy": see the Tidy theme.

name = Tidy Dark
variant of = Tidy
mode = dark
description = The dark Tidy mockup from Haiku's forum: charcoal panels, and the same yellow tab.
decorator = Tidy
control look = Tidy
wallpaper = default
desktop color = #336698
font plain = Noto Sans, Regular, 12
font bold = Noto Sans, Bold, 12
font fixed = Noto Sans Mono, Regular, 12
font menu = Noto Sans, Regular, 12

color B_DESKTOP_COLOR = #336698
icons = haiku

