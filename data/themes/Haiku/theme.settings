# Haiku's own look: the default window decorator, the built-in
# controls, the default system colours, desktop colour and fonts, and
# Haiku's own icons. Values from Haiku's source (InterfaceDefs.cpp,
# ServerConfig.h).

name = Haiku
variant of = Haiku
mode = light
description = Haiku's own look: yellow window tabs, the built-in controls, the default colors and fonts, and Haiku's icons.
decorator = Default
control look = haiku
icons = haiku
wallpaper = default
deskbar = right top, expanded
desktop color = #336698

font plain = Noto Sans, Regular, 12
font bold = Noto Sans, Bold, 12
font fixed = Noto Sans Mono, Regular, 12
font menu = Noto Sans, Regular, 12

color B_PANEL_BACKGROUND_COLOR = #D8D8D8
