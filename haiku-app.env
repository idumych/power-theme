# haiku-app.env: what the beos-app-platforms release tools need to know.
# Shell syntax; keep values quoted, no spaces around '='.

APP_NAME="PowerTheme"
APP_CMD="powertheme"                   # the package's name and its command
APP_SIG="application/x-vnd.idumych-PowerTheme"
RDEF="src/themes/Themes.rdef"

# Released for Haiku only. On Linux it builds against an installed Hokku
# (make COSMOE_ROOT=/usr, hokku.mk), not as an AppImage: AppImage apps keep the
# desktop's own frames, and the add-ons need Hokku's development files.
PLATFORMS="haiku"
APP_PATH="apps/PowerTheme"
DESKBAR_NAME="Power Theme"

VERSION="0.9"
REVISION="1"

SUMMARY="Power Theme: a theme manager with window borders, controls and icon themes"
HOMEPAGE="https://github.com/idumych/power-theme"
GITHUB_REPO="idumych/power-theme"
LICENSE_NAME="MIT"
COPYRIGHT="2026 idumych"
PACKAGER="idumych <idumych@users.noreply.github.com>"

HPKG_REQUIRES_EXTRA="lib:libstdc++"
HPKG_BUILD_DEPS="gcc haiku_devel"
TEST_CMD=""

# release/test-plan.md
FEATURE_CHECKS="themes modes dark-icons addons beos-tabs revert schedule frame window-size labels dano tidy expose platinum leopard gershwix next system7 amiga amigaos3 deskbar flat-tab"
EVIDENCE_1="{p}-themes.txt|Renku Light \\(light version of Renku\\)"
EVIDENCE_2="{p}-modes.txt|^dark: .*mode: dark"
EVIDENCE_3="{p}-modes.txt|^light: .*mode: light"
EVIDENCE_4="{p}-modes.txt|^scheduled: .*schedule: light at 07:00"
EVIDENCE_5="{p}-icons.txt|^dark icon differs from Haiku's"
EVIDENCE_6="{p}-icons.txt|^light icon matches Haiku's"
EVIDENCE_7="{p}-addons.txt|^themes missing add-ons: 0$"
EVIDENCE_8="{p}-tabs.txt|^tab narrower than the window: yes"
EVIDENCE_9="{p}-revert.txt|^differences from before any theme: 0$"
EVIDENCE_10="{p}-schedule.txt|^lines printed when turned on: 1$"
EVIDENCE_11="{p}-schedule.txt|^in the roster: 0$"
EVIDENCE_12="{p}-schedule.txt|^switched at the set time: yes$"
EVIDENCE_13="{p}-frame.txt|^pixels changed by a round trip: 0$"
EVIDENCE_14="{p}-window.txt|^height changed by Apply: 0$"
EVIDENCE_15="{p}-labels.txt|^desktop labels white: yes$"
EVIDENCE_16="{p}-dano.txt|^new application loads control look: Dano$"
EVIDENCE_17="{p}-tidy.txt|^new application loads control look: Tidy$"
EVIDENCE_18="{p}-tidy.txt|^window borders: Tidy$"
EVIDENCE_19="{p}-tidy.txt|^dark: .*theme: Tidy Dark.*mode: dark"
EVIDENCE_20="{p}-tidy.txt|^light: .*theme: Tidy[^ ]*.*mode: light"
EVIDENCE_21="{p}-expose.txt|^window borders: Expose$"
EVIDENCE_22="{p}-expose.txt|^new application loads control look: Expose$"
EVIDENCE_23="{p}-expose.txt|^dark: .*theme: Expose Dark.*mode: dark"
EVIDENCE_24="{p}-expose.txt|^light: .*theme: Expose[^ ]*.*mode: light"
EVIDENCE_25="{p}-platinum.txt|^window borders: Platinum$"
EVIDENCE_26="{p}-platinum.txt|^new application loads control look: Platinum$"
EVIDENCE_27="{p}-tabs.txt|^expose tab narrower than the window: yes"
EVIDENCE_28="{p}-tabs.txt|^platinum tab narrower than the window: yes"
EVIDENCE_29="{p}-tidy.txt|^square window borders: TidySquare$"
EVIDENCE_30="{p}-tidy.txt|^square dark: .*theme: Tidy Square Dark.*mode: dark"
EVIDENCE_31="{p}-tidy.txt|^renku dark: .*theme: Tidy Renku.*mode: dark"
EVIDENCE_32="{p}-tidy.txt|^renku light: .*theme: Tidy Renku Light.*mode: light"
EVIDENCE_33="{p}-tidy.txt|^renku square window borders: TidySquare$"
EVIDENCE_34="{p}-tidy.txt|^renku square dark: .*theme: Tidy Renku Square.*mode: dark"
EVIDENCE_35="{p}-tidy.txt|^renku square light: .*theme: Tidy Renku Square Light.*mode: light"
EVIDENCE_36="{p}-flat.txt|^rows with lines across the left-titled tab: 0$"
EVIDENCE_37="{p}-flat.txt|^decorators with rounding code: 0$"
EVIDENCE_38="{p}-leopard.txt|^window borders: Leopard$"
EVIDENCE_39="{p}-leopard.txt|^new application loads control look: Leopard$"
EVIDENCE_40="{p}-leopard.txt|^graphite window borders: Leopard$"
EVIDENCE_41="{p}-tabs.txt|^leopard tab narrower than the window: yes"
EVIDENCE_42="{p}-gershwix.txt|^window borders: Gershwix$"
EVIDENCE_43="{p}-gershwix.txt|^new application loads control look: Gershwix$"
EVIDENCE_44="{p}-gershwix.txt|^Gershwix themes listed: 7$"
EVIDENCE_45="{p}-next.txt|^window borders: NeXT$"
EVIDENCE_46="{p}-next.txt|^new application loads control look: NeXT$"
EVIDENCE_47="{p}-tabs.txt|^gershwix tab narrower than the window: yes"
EVIDENCE_48="{p}-tabs.txt|^next tab narrower than the window: yes"
EVIDENCE_49="{p}-system7.txt|^window borders: System7$"
EVIDENCE_50="{p}-system7.txt|^new application loads control look: System7$"
EVIDENCE_51="{p}-amiga.txt|^window borders: Amiga$"
EVIDENCE_52="{p}-amiga.txt|^new application loads control look: Amiga$"
EVIDENCE_53="{p}-amiga.txt|^subpixel smoothing with Amiga: off$"
EVIDENCE_54="{p}-amigaos3.txt|^window borders: AmigaOS3$"
EVIDENCE_55="{p}-amigaos3.txt|^new application loads control look: AmigaOS3$"
