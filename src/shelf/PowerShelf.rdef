resource app_signature "application/x-vnd.idumych-PowerTheme-shelf";

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major = 0,
	middle = 9,
	minor = 0,
	variety = B_APPV_ALPHA,
	internal = 0,
	short_info = "Power Theme shelf",
	long_info = "A desktop shell in the style of QNX 6's Photon: a taskbar and a shelf of launchers, in place of the Deskbar."
};
