[%General]
author=Phobian347
comment=Aero for my Expose series
active_tab_overlap=2
alt_mnemonic=true
animate_states=false
attach_active_tab=true
blurring=false
bold_active_tab=true
button_contents_shift=true
button_icon_size=16
center_toolbar_handle=false
check_size=16
click_behavior=0
combo_as_lineedit=true
combo_focus_rect=false
combo_menu=true
composite=true
contrast=1.00
dialog_button_layout=0
fill_rubberband=false
groupbox_top_label=false
group_toolbar_buttons=false
hide_combo_checkboxes=false
inline_spin_indicators=true
intensity=1.00
joined_inactive_tabs=false
large_icon_size=32
layout_margin=6
layout_spacing=6
left_tabs=true
menubar_mouse_tracking=true
menu_separator_height=7
menu_shadow_depth=4
merge_menubar_with_toolbar=false
min_height=16
mirror_doc_tabs=true
no_active_tab_separator=true
no_inactiveness=false
no_inactive_tab_expansion=true
no_window_pattern=false
opaque=qbittorrent,inkscape
popup_blurring=false
progressbar_thickness=1.5font
reduce_menu_opacity=0
reduce_window_opacity=0
remove_extra_frames=false
respect_DE=true
saturation=1.00
scrollable_menu=true
scroll_arrows=true
scrollbar_in_view=true
scroll_min_extent=32
scroll_width=14
shadowless_popup=false
slider_handle_length=12
slider_handle_width=24
slider_width=3
small_icon_size=16
spin_button_width=16
splitter_width=3
spread_header=false
spread_menuitems=false
spread_progressbar=true
square_combo_button=false
submenu_delay=250
submenu_overlap=0
tab_button_extra_margin=0
toolbar_icon_size=16
toolbar_interior_spacing=3
toolbar_item_spacing=3
toolbutton_style=0
tooltip_delay=-1
tooltip_shadow_depth=4
transient_groove=false
transient_scrollbar=false
translucent_windows=false
tree_branch_line=true
vertical_spin_indicators=true
x11drag=all


[GeneralColors]
window.color=#2d2e2c
base.color=#1e1f1c
alt.base.color=#1e1f1c
button.color=#2d2e2c
light.color=#98a0a8
mid.light.color=#ccd9ea
dark.color=#262725
mid.color=#98a0a8
inactive.highlight.color=#4e4e4e
text.color=#d0d1ce
inactive.text.color=#d0d1ce
window.text.color=#d0d1ce
inactive.window.text.color=#d0d1ce
button.text.color=#eff0ec
disabled.text.color=#d0d1ce70
tooltip.text.color=#d0d1ce
highlight.text.color=#eff0ec
inactive.highlight.text.color=#d0d1ce
highlight.color=#646b76
inactive.highlight.color=#afbdd3
link.color=#7294e8
link.visited.color=#ff00ff
progress.indicator.text.color=#eff0ec
progress.inactive.indicator.text.color=#eff0ec

[Hacks]

[WindowTranslucent]
interior=false
interior.element=window
interior.x.patternsize=32
interior.y.patternsize=32
frame.expansion=0

[Window]
interior=true
interior.element=window

[PanelButtonCommand]
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0
interior.element=tbaritem
interior=true
frame=true
frame.element=tbaritem
indicator.size=8

[PanelButtonTool]
interior.element=tbaritem
interior=true
frame=true
frame.element=tbaritem
indicator.size=9
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3




[GenericFrame]
#inherits=PanelButtonCommand
frame=true
interior=true
frame.element=window
interior.element=window
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[LineEdit]
frame.element=ledit
interior.element=ledit
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[IndicatorSpinBox]
indicator.element=sparrow
indicator.size=16

[DropDownButton]
indicator.element=cind
indicator.size=16

[ToolboxTab]
inherits=PanelButtonCommand
text.margin.top=4
text.margin.bottom=4
text.margin.left=4
text.margin.right=4

[Tab]
frame.top=5
frame.bottom=3
frame.left=3
frame.right=3
focusFrame=true
text.margin.top=3
text.margin.bottom=3
frame.expansion=0
indicator.size=12
interior.element=tab
frame.element=tab
#text.normal.color=#1e395b


[TabFrame]
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.element=tabframe
interior.element=tabframe
frame=true
interior=true
focusFrame=true

[TreeExpander]
indicator.size=11
indicator.element=tree

[HeaderSection]
frame.element=tab
interior.element=tab
indicator.element=arrow
indication.size=8
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame=true
interior=true

[GroupBox]
interior=true
frame=true
frame.element=gbox
interior.element=gbox
text.bold=false
frame.expansion=0
#text.normal.color=#ffb700

[TabBarFrame]
frame=true
frame.element=tbframe
interior=true
interior.element=tbframe
frame.left=3
frame.right=3
frame.top=3
frame.bottom=3

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=15

[Toolbar]
frame.left=1
frame.right=1
frame.top=1
frame.bottom=1
indicator.size=3
frame.expansion=0
interior.element=mmbar
interior=true
frame=true
frame.element=mmbar
indicator.element=tbar
#text.normal.color=#ff395b

[Scrollbar]
indicator.size=16
frame.expansion=0
indicator.element=scarrow

[ScrollbarGroove]
interior=true
interior.element=trough
frame.element=trough
frame=true
frame.left=2
frame.right=2
frame.top=2
frame.bottom=2

[ScrollbarSlider]
interior=true
frame=true
frame.left=2
frame.right=2
frame.top=2
frame.bottom=2
frame.expansion=0
interior.element=scrollslide
frame.element=scrollslide
indicator.element=sgrip
indicator.size=12

[Progressbar]
text.bold=true
text.normal.color=#d0d1ce
frame.expansion=0
interior.element=pbgutter
frame.element=pbgutter
frame=true
interior=true
frame.left=3
frame.right=3
frame.top=3
frame.bottom=3

[ProgressbarContents]
frame=true
interior=true
frame.element=pbc
interior.element=pbc
frame.expansion=0
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
text.toggle.color=#eff0ec
text.press.color=#eff0ec
#text.normal.color=black
#text.focus.color=black
text.focus.inactive.color=#4a5362
text.toggle.inactive.color=#4a5362
frame.expansion=0
interior=true
interior.element=iview
frame.element=iview
frame=true
#text.margin=6
focusFrame=false
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[Menu]
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior.element=mnu
frame.element=mnu
frame=true
interior=true
text.margin=3

[MenuItem]
frame=true
frame.element=menuitem
interior=true
interior.element=menuitem
frame.expansion=0
indicator.element=arrow
indicator.size=8
text.toggle.color=#eff0ec

[MenuBarItem]
interior=true
interior.element=mbaritem
frame.element=mbaritem
frame=true
frame.expansion=0
#text.toggle.color=green
text.press.color=#eff0ec
#text.normal.color=black

[MenuBar]
interior=true
frame=true
interior.element=mmbar
frame.element=mmbar
frame.expansion=0
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
# text.normal.color=#1e395b

[TitleBar]
inherits=PanelButtonCommand
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3
text.bold=true
text.italic=true
text.normal.color=white

[ComboBox]
interior.element=tbaritem
frame.element=tbaritem
frame=true
indicator.size=16
indicator.element=cind
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.press.color=#eff0ec

[Splitter]
indicator.size=32

[Slider]
frame.element=slider
interior.element=slider
interior=true
frame=true
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[SliderCursor]
frame=true
interior=true
interior.element=scrubber
frame.element=scrubber
frame=true
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[Focus]
frame=false
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=6

[ToolTip]
interior=true
frame=true
interior.element=mnu
frame.element=mnu
text.normal.color=black

[RadioButton]
text.focus.color=#eff0ec

[CheckBox]
#text.normal.color=black
text.focus.color=#eff0ec

[DockTitle]
text.bold=true
#text.normal.color=#1e395b
interior=true
frame=true
interior.element=menuitem
frame.element=menuitem

[Dock]
indicator.element=dck
indicator.size=12
interior=true
frame=false
interior.element=window
frame.element=dck
